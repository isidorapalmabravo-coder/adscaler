# Copia este archivo como .env.local y pega tus claves.
# Sin claves la app funciona en MODO DEMO (prompts e imágenes de ejemplo).

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI Platform → https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high. La app usa "low": en las pruebas mantuvo persona y producto por ~US$0,03 la toma.
OPENAI_IMAGE_QUALITY=low
# Fotos del producto que se envían como referencia en cada toma (cada una cuesta). La primera es la principal.
MAX_PRODUCT_REFS=1

# Límite de imágenes por mes que muestra la barra lateral
MONTHLY_IMAGE_LIMIT=270
